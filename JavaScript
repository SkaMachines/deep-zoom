// Inicialização do Panzoom
const elem = document.getElementById('vending-img');
const panzoom = Panzoom(elem, {
  maxScale: 5,
  minScale: 1,
  contain: 'outside'
});

elem.parentElement.addEventListener('wheel', panzoom.zoomWithWheel);

// Interatividade dos Hotspots
document.querySelectorAll('.hotspot').forEach(hotspot => {
  hotspot.addEventListener('click', (e) => {
    const id = e.target.getAttribute('data-id');
    const prod = produtos[id];

    if (prod) {
      document.getElementById('product-title').innerText = prod.nome;
      document.getElementById('product-tag').innerText = prod.categoria;
      document.getElementById('product-img').src = prod.foto;
      document.getElementById('nutrition-img').src = prod.tabelaImg;
      document.getElementById('product-benefit').innerText = prod.beneficio;
      document.getElementById('kcal').innerText = prod.kcal;
      document.getElementById('protein').innerText = prod.protein;
      document.getElementById('carbs').innerText = prod.carbs;
      document.getElementById('fat').innerText = prod.fat;

      document.getElementById('product-modal').classList.remove('hidden');
    }
  });
});

// Fechar modal
document.getElementById('close-btn').addEventListener('click', () => {
  document.getElementById('product-modal').classList.add('hidden');
});
